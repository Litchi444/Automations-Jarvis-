# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# ── Versions ─────────────────────────────────────────────────
N8N_VERSION=2.48.8
FFMPEG_VERSION=8.1

# ── Timezone (drives the 07:30 schedule) ─────────────────────
GENERIC_TIMEZONE=Europe/Paris

# ── n8n core ─────────────────────────────────────────────────
# CRITICAL: encrypts every stored credential. Lose it = re-enter all creds.
# Back it up somewhere other than this machine.
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Local PC: keep localhost / http.
# Oracle VM: set your domain, https, and start with `--profile cloud` (Caddy).
N8N_HOST=localhost
N8N_PROTOCOL=http
# Public base URL. Google OAuth redirect URI = ${WEBHOOK_URL}rest/oauth2-credential/callback
WEBHOOK_URL=http://localhost:5678/
# Leave true. Only set false if you reach the editor over plain http
# from something other than localhost (not recommended).
N8N_SECURE_COOKIE=true

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=n8n

# ── Telegram (read by the workflow through $env) ─────────────
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token
# @userinfobot -> /start. Then send /start to YOUR bot once,
# otherwise Telegram refuses to let the bot message you.
TELEGRAM_CHAT_ID=123456789

# Gemini API key is NOT stored here: it goes into an n8n
# "Header Auth" credential (encrypted at rest). See README.
